<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Opto.ViewModels"
        xmlns:models="using:Opto.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560" d:DesignHeight="480"
        x:Class="Opto.Views.BaxtaWatchScheduleWindow"
        x:DataType="vm:BaxtaWatchScheduleViewModel"
        Title="График вахт"
        Width="560"
        MinWidth="480"
        Height="480"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F4F8FA">

    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Classes="primary" Content="Закрыть" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" MinWidth="110" />
        </DockPanel>

        <StackPanel Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="brand-sm" Text="ОПТО" />
                <TextBlock Classes="module-title" Text="График вахт" />
                <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="32,56,56,56,56,56,56" ColumnSpacing="8">
                <TextBlock Classes="col-header" Text="#" />
                <TextBlock Grid.Column="1" Classes="col-header" Text="1 смена" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="col-header" Text="2 смена" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="col-header" Text="3 смена" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="col-header" Text="Отдых" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Classes="col-header" Text="→" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="col-header" Text="ММ.ДД" HorizontalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="#9EB4C2" />

            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BaxtaWatchScheduleRow">
                            <Grid ColumnDefinitions="32,56,56,56,56,56,56" ColumnSpacing="8" Margin="0,4">
                                <TextBlock Classes="report-value" Text="{Binding RowIndex}" />
                                <TextBlock Grid.Column="1" Classes="report-value" Text="{Binding Shift1WatchLetter}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="report-value" Text="{Binding Shift2WatchLetter}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Classes="report-value" Text="{Binding Shift3WatchLetter}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Classes="report-value" Text="{Binding RestingWatchLetter}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5" Classes="report-value" Text="●"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           IsVisible="{Binding IsNext}" />
                                <TextBlock Grid.Column="6" Classes="report-value" Text="{Binding LastDateText}" HorizontalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Classes="hint" Text="Цифры 1–4 = вахты А, Б, В, Г. Строка с ● — следующий первичный расчёт."
                       TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
