<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Opto.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="560" d:DesignHeight="320"
             x:Class="Opto.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">

    <Border Margin="28"
            Padding="28"
            CornerRadius="4"
            Background="#F4F8FA"
            BorderBrush="#7A93A3"
            BorderThickness="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MinWidth="420"
            MaxWidth="560">
        <StackPanel Spacing="16">
            <TextBlock Classes="brand-sm" Text="ОПТО" />
            <TextBlock Classes="module-title" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="subtitle"
                       Text="Модуль будет подключён позже."
                       TextWrapping="Wrap" />
            <Button Classes="menu"
                    Content="← Назад в главное меню"
                    Command="{Binding GoBackCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
