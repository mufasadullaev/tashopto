<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Opto.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Opto.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Title="ОПТО — ТашТЭС">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#D7E4EC" Offset="0" />
                <GradientStop Color="#B9CBD6" Offset="0.55" />
                <GradientStop Color="#9EB4C2" Offset="1" />
            </LinearGradientBrush>
        </Panel.Background>

        <ContentControl Content="{Binding CurrentPage}" />
    </Panel>
</Window>
