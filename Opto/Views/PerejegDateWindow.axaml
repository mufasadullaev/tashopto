<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Opto.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="420" d:DesignHeight="300"
        x:Class="Opto.Views.PerejegDateWindow"
        x:DataType="vm:PerejegDateViewModel"
        Title="{Binding Title}"
        Width="420"
        MinWidth="380"
        SizeToContent="Height"
        MaxHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F4F8FA">

    <DockPanel Margin="28">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,8">
            <Button Classes="exit" Content="Отмена" Command="{Binding CancelCommand}"
                    DockPanel.Dock="Left" MinWidth="110" />
            <Button Classes="primary" Content="Продолжить" Command="{Binding ContinueCommand}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="130" />
        </DockPanel>

        <StackPanel Spacing="16">
            <TextBlock Classes="module-title" Text="{Binding Title}" />
            <TextBlock Classes="hint" Text="{Binding Prompt}" TextWrapping="Wrap" />
            <CalendarDatePicker SelectedDate="{Binding SelectedDate}"
                                Watermark="ДД.ММ.ГГГГ"
                                HorizontalAlignment="Stretch" />
            <TextBlock Classes="validation"
                       Text="{Binding ValidationMessage}"
                       IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
