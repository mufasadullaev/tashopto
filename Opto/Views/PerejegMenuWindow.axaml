<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Opto.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="520" d:DesignHeight="480"
        x:Class="Opto.Views.PerejegMenuWindow"
        x:DataType="vm:PerejegMenuViewModel"
        Title="Пережоги топлива"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        MaxHeight="720"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F4F8FA">

    <Design.DataContext>
        <vm:PerejegMenuViewModel />
    </Design.DataContext>

    <DockPanel Margin="28">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,8">
            <Button Classes="exit"
                    Content="Назад"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Left"
                    MinWidth="110" />
        </DockPanel>

        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="brand-sm" Text="ОПТО" />
                <TextBlock Classes="module-title" Text="Пережоги топлива" />
                <TextBlock Classes="subtitle" Text="Выберите режим работы" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Button Classes="menu" Content="Расчёт пережогов за сутки"
                        Command="{Binding SelectDailyCalculationCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button Classes="menu" Content="Печать суточных пережогов"
                        Command="{Binding SelectPrintDailyCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button Classes="menu" Content="Печать нарастающего итога"
                        Command="{Binding SelectPrintCumulativeCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button Classes="menu" Content="Просмотр расчётных дат"
                        Command="{Binding SelectViewDatesCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button Classes="menu" Content="Печать бланка для данных"
                        Command="{Binding SelectPrintBlankCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
