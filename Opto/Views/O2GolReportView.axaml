<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Opto.ViewModels"
             xmlns:models="using:Opto.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Opto.Views.O2GolReportView"
             x:DataType="vm:O2GolReportViewModel">

    <Design.DataContext>
        <vm:O2GolReportViewModel />
    </Design.DataContext>

    <Border Background="#F4F8FA">
        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <TextBlock Classes="hint" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                    <Button Classes="accent" Content="Экспорт в Excel/CSV" Command="{Binding ExportCsvCommand}" MinWidth="140" />
                    <Button Classes="primary" Content="Печать" Command="{Binding PrintCommand}" MinWidth="120" />
                    <Button Classes="exit" Content="← В меню" Command="{Binding GoBackCommand}" MinWidth="120" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Classes="brand-sm" Text="ОПТО" />
                    <TextBlock Classes="module-title" Text="{Binding Title}" />
                    <TextBlock Classes="subtitle" Text="{Binding PeriodText}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24">
                    <ContentControl Content="{Binding ByBlocks}">
                        <ContentControl.DataTemplates>
                            <DataTemplate x:DataType="models:O2GolSummarySection">
                                <StackPanel Spacing="8" Margin="0,0,0,8">
                                    <TextBlock Classes="section" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="col-header" Text="" Width="140" />
                                        <ItemsControl ItemsSource="{Binding ColumnHeaders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Classes="col-header" Text="{Binding}"
                                                               Width="56" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="col-header" Text="Σ" Width="64" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Height="1" Background="#9EB4C2" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:O2GolSummaryRow">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                                    <TextBlock Classes="row-num" Text="{Binding Label}" Width="140" />
                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Classes="report-value" Text="{Binding}"
                                                                           Width="56" HorizontalAlignment="Right" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="report-value" Text="{Binding TotalText}"
                                                               Width="64" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>

                    <ContentControl Content="{Binding ByWatches}">
                        <ContentControl.DataTemplates>
                            <DataTemplate x:DataType="models:O2GolSummarySection">
                                <StackPanel Spacing="8" Margin="0,0,0,8">
                                    <TextBlock Classes="section" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Classes="col-header" Text="" Width="140" />
                                        <ItemsControl ItemsSource="{Binding ColumnHeaders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Classes="col-header" Text="{Binding}"
                                                               Width="72" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="col-header" Text="Σ" Width="72" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Height="1" Background="#9EB4C2" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:O2GolSummaryRow">
                                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,3">
                                                    <TextBlock Classes="row-num" Text="{Binding Label}" Width="140" />
                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Classes="report-value" Text="{Binding}"
                                                                           Width="72" HorizontalAlignment="Right" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="report-value" Text="{Binding TotalText}"
                                                               Width="72" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>

                    <ItemsControl ItemsSource="{Binding OperatorGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:O2GolOperatorGroup">
                                <StackPanel Spacing="8" Margin="0,8,0,0"
                                            IsVisible="{Binding Rows.Count}">
                                    <TextBlock Classes="section"
                                               Text="{Binding Title, StringFormat=Пережог / экономия по машинистам · {0}}" />
                                    <Grid ColumnDefinitions="56,40,40,56,48,48,48,48,48,48,48,48,56,48"
                                          ColumnSpacing="4">
                                        <TextBlock Classes="col-header" Text="Маш-ст" />
                                        <TextBlock Grid.Column="1" Classes="col-header" Text="Бл." HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="col-header" Text="См." HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="col-header" Text="МВт·ч" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Classes="col-header" Text="МВт" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Classes="col-header" Text="ПУГ" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Classes="col-header" Text="ВАК" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Classes="col-header" Text="ДОП" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="8" Classes="col-header" Text="ТОП" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="9" Classes="col-header" Text="ТПП" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="10" Classes="col-header" Text="СН" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="11" Classes="col-header" Text="ТПВ" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="12" Classes="col-header" Text="ВСЕГО" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="13" Classes="col-header" Text="г/кВт·ч" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Height="1" Background="#9EB4C2" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:O2GolOperatorRow">
                                                <Grid ColumnDefinitions="56,40,40,56,48,48,48,48,48,48,48,48,56,48"
                                                      ColumnSpacing="4" Margin="0,3">
                                                    <TextBlock Classes="report-value" Text="{Binding OperatorTn}" />
                                                    <TextBlock Grid.Column="1" Classes="report-value" Text="{Binding BlockNumber}" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Classes="report-value" Text="{Binding ShiftCount}" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Classes="report-value" Text="{Binding GenerationText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Classes="report-value" Text="{Binding LoadText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Classes="report-value" Text="{Binding PugText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="6" Classes="report-value" Text="{Binding WakText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="7" Classes="report-value" Text="{Binding DopText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="8" Classes="report-value" Text="{Binding TopText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="9" Classes="report-value" Text="{Binding TppText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="10" Classes="report-value" Text="{Binding SnText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="11" Classes="report-value" Text="{Binding TpwText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="12" Classes="report-value" Text="{Binding TotalText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="13" Classes="report-value" Text="{Binding GkwhText}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
