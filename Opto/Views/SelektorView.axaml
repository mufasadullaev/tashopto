<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Opto.ViewModels"
             x:Class="Opto.Views.SelektorView"
             x:DataType="vm:SelektorViewModel">
    <DockPanel Margin="16">
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F4F6F8" Padding="12" CornerRadius="6" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Content="← Назад в меню" Classes="secondary" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <CalendarDatePicker SelectedDate="{Binding Date}" Watermark="ДД.ММ.ГГГГ" VerticalAlignment="Center" Width="160" />
                    <Button Command="{Binding CalculateCommand}" Content="Сформировать" Classes="accent" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Center">
                <TextBlock Text="Оперативный расчёт для селектора" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />

                <Border Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="12" DataContext="{Binding Report}">
                        <TextBlock Text="Сводные показатели электростанции" FontWeight="Bold" FontSize="16" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Суммарная выработка (МВт):" FontSize="14" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalGenerationMw}" FontWeight="Bold" FontSize="14" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Собственные нужды (МВт):" FontSize="14" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalOwnNeedsMw}" FontWeight="Bold" FontSize="14" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Отпуск в сеть (МВт):" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StationReleaseMw}" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,10,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Block table -->
                <DataGrid ItemsSource="{Binding Report.Blocks}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ Блока" Binding="{Binding BlockNumber}" Width="100" />
                        <DataGridTextColumn Header="Выработка (МВт)" Binding="{Binding GenerationMw}" Width="160" />
                        <DataGridTextColumn Header="СН (МВт)" Binding="{Binding OwnNeedsMw}" Width="160" />
                        <DataGridTextColumn Header="Часы работы" Binding="{Binding OperatingHours}" Width="120" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding Comment}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
