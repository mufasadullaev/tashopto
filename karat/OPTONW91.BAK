procedure SELZAM
*§ ¬¥­  áç¥âç¨ª®¢
jjj=0
gg=0
gam=0
nn=0
nn1=0.0
nn2=0.0
nn3=0.0
nn4=0.0
nn5=0
clear
zam=1
   @ 10,20 say " ‡€Œ…€ ‘—…’—ˆŠ‚ ?    …’   „€ "
   @ 10,42 prompt " …’ "
   @ 10,48 prompt " „€ "
   menu to zam
if zam=1.or.zam=0
  return
endif
select 2
go top
i=1
do SELEKRZ
zw1=0
go top
mini=1
lld=0
count to lld
if lld=0
   append blank
   repl zap with 1
  maxi=1
      else
         go top
         mini=zap
         go bott
         maxi=zap
endif
go top
do while .t.
   @ gam,2 get zap1 pict "999"
   @ gam,7 get zap2 pict "999999"
   @ gam,17 get zap3 pict "99999.999"
   @ gam,28 get zap4 pict "99999.999"
   @ gam,39 get zap5 pict "99999.9"
   read
l = readkey()
   @ gam,2 say zap1 pict "999"
   @ gam,7 say zap2 pict "999999"
   @ gam,17 say zap3 pict "99999.999"
   @ gam,28 say zap4 pict "99999.999"
   @ gam,39 say zap5 pict "99999.9"
if l = 12       &&  esc
 exit
endif
if l=5.or.l=270.or.l=15    && ãá.end,enter,áâà¥«ª  ¢­.
   if i = maxi
      i=i+1
      maxi=i
      skip
      append blank
      repl zap with i
      gam=gam+1
      if gam>21
         do SELEKRZ
      endif
      loop
   endif
   skip
   gam=gam+1
   i=i+1
   if gam>21
      do SELEKRZ
   endif
   loop
endif
if l = 4                      &&    áâà¥«ª  ¢¢.
   if i = mini
      loop
   endif
   skip -1
   gam=gam-1
   i=i-1
   if gam<4 .and. i>17
      skip -17
      do SELEKRZ
      skip 17
      gam=21
   endif
   if gam<4
      go top
      i=1
      do SELEKRZ
      loop
   endif
endif
if l = 33      && ãá.Home
   if i=mini
      dele
      pack
      if mini=maxi
         append blank
         repl zap with 1
         mini=1
         maxi=1
       endif
      do SELEKRZ
      if mini < maxi
         i=1
         go top
         do while ! eof()
            repl zap with i
            skip
            i=i+1
         enddo
         go top
         mini=1
         maxi=i
         i=1
         gam=4
      endif
      loop
   endif
   jj=i-1
   dele
   pack
   jjj=gam-1
   i=i-1
   if i<maxi
      go top
      seek i
      do while ! eof()
         skip
         i=i+1
         repl zap with i
      enddo
   endif
      go bott
      maxi=zap
      go top
      mini=zap
      i=jj
      jj=i/18
      gg=int(jj)
      jj=gg*18
      skip jj
      do SELEKRZ
      go top
      seek i
      gam=jjj
endif
if l = 34      && ãá.PgUp
   if i=mini
      loop
   endif
   i=1
   go top
   do SELEKRZ
   gam=4
   loop
endif
if l = 35         && ãá.PgDn
   if i=maxi
      loop
   endif
   jjj=int(maxi/19)
   gg=jjj*18
   go top
   skip gg
   jjj=maxi-gg
   do SELEKRZ
   go bott
   i=zap
   gam=jjj+3
   loop
endif
if l = 6    &&PgUp
   if i=mini
      loop
   endif
   if i<19
      go top
      i=1
      gam=4
      loop
   endif
   jjj=int(i/19)
   gg=jjj-1
   jjj=gg*18
   go top
   skip jjj
   i=zap
   do SELEKRZ
   loop
endif
if l = 7       && PgDn
   if i=maxi
      loop
   endif
   jjj=int(i/19)
   gg=18*(jjj+1)
   if gg>maxi
      go bott
      jjj=zap-i
      gam=gam+jjj
      i=zap
      loop
   endif
   go top
   skip gg
   i=zap
   do SELEKRZ
   loop
endif
enddo
return

procedure SELEKRZ
clear
@ 0,20 say "‡€Œ…€ ‘—…’—ˆŠ‚."
@ 1,0 say  "ÉÍÍÍÍËÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍÍ»"
@ 2,0 say  "º  N º Š”-’  º / ­ ç. º / ª®­ .º / ¬¨¬® º"
@ 3,0 say  "ÌÍÍÍÍÎÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÍ¹"
