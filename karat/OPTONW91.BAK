procedure STARRING
starr=0
set console on
set color to r/w
*@ 21,13 say "                                                     "
i=1
k=0
do while .t.
k=k+1
if k=71
k=1
endif
do case
case k>0.and.k<11
*set color to BG+
case k>10.and.k<21
*set color to R+
case k>20.and.k<31
*set color to GR+
case k>30.and.k<41
*set color to G+
case k>40.and.k<51
*set color to B+
case k>50.and.k<61
*set color to W+
case k>60.and.k<71
*set color to RB+
endcase
if starr=200
exit
endif
*@ 21,14 say star(i) pict ""
set color to X
*@ 21,13 say " "
*@ 21,65 say " "
i=i+1
if i>51
i=1
endif
j=1

do while j<370
j=j+1
l=inkey()
if l # 0
exit
endif
enddo

if l # 0
exit
endif
starr=starr+1
enddo
return
