   set filter to li0=zkk
   lld=0
   count to lld
   if lld>0
      go top
      zkk1=li1*(li3-li2)
      zkk1=(zkk1+li4)*0.001
      prom=trtr3
      trtr2=li2
      trtr3=li3
      repl li6 with prom
      zw1=1
