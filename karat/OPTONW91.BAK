               mac(i)=mac(i)+iraz
               exit
            endif
            i=i-1
         enddo
         loop
      endif
      if s1#0.or.s2#0
         if abs(s1)>=abs(s2)
         s1=s1+iraz
         endif
         if abs(s1)<abs(s2)
         s2=s2+iraz
         endif
      endif
      exit
   endif
   exit
enddo
