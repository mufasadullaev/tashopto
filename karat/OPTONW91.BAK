@ gam,0 say "ÈÍÍÍÍÊÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÍ¼"
gam=4
jj=0
do while .not. eof()
   @ gam,2 say zap1 pict "999"
   @ gam,7 say zap2 pict "999999"
   @ gam,17 say zap3 pict "99999.999"    
   @ gam,28 say zap4 pict "99999.999"
   @ gam,39 say zap5 pict "99999.9"
   gam=gam+1
   skip
   jj=jj+1
   if gam>21
      exit
   endif
enddo
gam=4
skip -jj
@ 23,2 say "<Enter>,-„®¡ ¢«¥­¨¥ áâà®ª¨ , <Ctrl/Home>-“¤ «¥­¨¥ áâà®ª¨"    
return

procedure REDSEL1
@ 0,0 say  "ÉÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÍÍÍ» "
@ 1,0 say  "º N ¡«®ª  º  á¥ªæ¨ï º áç¥âç¨ª º­ ç.¯®ª §.ºª®­.¯®ª §.º "
@ 2,0 say  "ÌÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÍÎÍÍÍÍÍÍÍÍÍÍ¹ "
@ 23,0 say "ÈÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÍÍÍ¼ "
@ 24,0 say re pict ""
select 1
use sel1 index sel1
kol=3
mini=1
maxi=18
max=144
go top
j=1
mm=1
do SELEKR1
kol = 3
do while .t.
if prizn = 77
@ kol,32 get sen pict "99999.999"
   else
@ kol,43 get sek pict "99999.999"
endif
read
l = readkey()
if prizn = 77
@ kol,32 say sen pict "99999.999"
   else
@ kol,43 say sek pict "99999.999"
endif
if l = 12
exit
endif
if l = 36
loop
nom=abc
nm=0
lll=0
do while .t.
l=inkey(0)
if l<45 .or.l>57 .or. l=46 .or. l=47
exit
endif
if l=45
lll=1
else
nm=nm*10+l-48
endif
enddo
if lll=1
nm=0-nm
endif
if nm < mini .or. nm > max
loop
endif
seek nm
if ! found()
seek nom
loop
endif
now1=(nm-1)/18
cel1=int(now1)
k=cel1
j=cel1+1
kol=3
do SELEKR1
seek nm
kol=abc-k+3
loop
endif
if l = 4    && áâà¥«ª  ¢¢.
 if abc = mini
  loop
 endif
 skip -1
 nom=abc
 if nom=18.or.nom=36.or.nom=54.or.nom=72.or.nom=90.or.nom=108.or.nom=126
   j=j-1
   do SELEKR1
   kol=22
   skip 17
   loop
 endif
if kol > 3
   kol = kol - 1
      if kol=9.or.kol=16
         kol=kol-1
      endif
   loop
     else
       kol=3
       do SELEKR1
       seek nom
       kol=3
endif
loop
endif
if l=34
   if abc = mini
      loop
   endif
   go top
   kol=3
   j=1
   do SELEKR1
   kol=3
   loop
endif
if l=35
   if abc = max
      loop
   endif
   go top
   skip 126
   kol=3
   j=8
   do SELEKR1
   kol=3
   loop
endif
if l=6
   if abc = mini
      loop
   endif
   if j=1
      go top
         else
            j=j-1
    endif
   do SELEKR1
   kol=3
   loop
endif
if l=7
   if abc = maxi
      loop
   endif
   if j=8
      go bott
      kol=22
      loop
         else
            j=j+1
            do SELEKR1
            kol=3
            loop
    endif
endif
if l=5.or.l=270.or.l=15
   if abc=144
      loop
   endif
 skip
 if kol<23
   kol=kol+1
 endif
 if kol=9.or.kol=16
   kol=kol+1
 endif
 if abc=19.or.abc=37.or.abc=55.or.abc=73.or.abc=91.or.abc=109.or.abc=127
   kol=3
   j=j+1
   do SELEKR1
   kol=3
 endif
loop
endif
enddo
return

