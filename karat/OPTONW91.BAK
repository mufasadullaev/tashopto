         sin3=10e4
      case i>187
         w2=ego4     && ª®­ ¯®ª-ï áç âà ­áä-à®¢
         sin3=10e4
   endcase
   skip
   select 2
   k2=zak1           && ­®¬¥à áç¥âç¨ª 
   skip
   sin1=w2-w1        && à §­®áâì
   if sin1<0
      sin1=sin1+sin3
   endif
