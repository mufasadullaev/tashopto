      s1=li2
      s2=li3
      zw2=1
      repl li6 with prom
      select 1
*      repl pks with s2
   endif
   set filter to
endif
kk3=kk3+zkk1
if t1 > 0
   kk4=kk3/t1
   kk5=kk3/kk1*100
endif
sum1=sum1+t1
sum2=sum2+kk1
sum3=sum3+kk3
select 1
return
